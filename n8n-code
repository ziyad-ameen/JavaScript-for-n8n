const rows = $input.all();
const NOW = Date.now();
const FIFTEEN_MIN_MS = 15 * 60 * 1000;

const currentCustomerId = rows[0]?.json?.customer_id || 
                          $input.first()?.json?.body?.from || 
                          $input.first()?.json?.from;

const recentRows = rows.filter(item => {
  const rowData = item.json;
  
  if (currentCustomerId && rowData.customer_id) {
    if (rowData.customer_id !== currentCustomerId) return false;
  }

  const rawTime = rowData.timestamp || rowData.Timestamp;
  if (!rawTime) return false;

  // Convert "2026-08-31 17:19:27" to "2026-08-31T17:19:27+08:00" to enforce KL offset
  let isoString = String(rawTime).replace(' ', 'T');
  if (!isoString.includes('+') && !isoString.includes('Z')) {
    isoString += '+08:00'; 
  }

  const parsedTime = new Date(isoString).getTime();
  if (isNaN(parsedTime)) return false;

  const diff = NOW - parsedTime;

  // Keep if message was sent within the last 15 minutes
  return diff >= 0 && diff <= FIFTEEN_MIN_MS;
});

const formattedHistory = recentRows.map(item => {
  const role = item.json.direction === 'incoming' ? 'Customer' : 'Bot';
  const time = item.json.timestamp || item.json.Timestamp;
  return `[${time}] ${role}: ${item.json.message}`;
}).join('\n');

return [
  {
    json: {
      formatted_conversation_history: formattedHistory || "No messages in the last 15 minutes."
    }
  }
];
